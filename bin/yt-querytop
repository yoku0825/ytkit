use strict;
use warnings;
use utf8;
binmode STDOUT, ":utf8";

use JSON qw{ from_json };
use Term::ReadKey;

use FindBin qw/$Bin/;
use lib "$Bin/../lib";
use Ytkit::Collect::QueryTop;
use Ytkit::IO;

if (my $prog= Ytkit::Collect::QueryTop->new(@ARGV))
{
  $SIG{QUIT} = sub { ReadMode("restore") };
  ReadMode("cbreak");
  while ()
  {
    my $key= ReadKey(-1);
  
    if (defined($key) && ($key eq "q" || $key eq "Q"))
    {
      ReadMode("restore");
      last;
    }

    if (my $ret= $prog->one_cycle())
    {
      printf("count/s\ttime_total\ttime/q\tschema\tsql\n");
      print join("\n", @$ret);
    }
    sleep $prog->{interval};

    if (!($prog->{debug}))
    {
      print Ytkit::IO::TERM_CLEAR_SEQUENCE;
    }
  }
}
else
{
  exit 1;
}

exit 0;
